# ===================================
# AI Support Hub - PRODUCTION Environment
# ===================================
# DO NOT commit this file to version control!
# Copy from .env.example and fill in production values

# ===================================
# Database Configuration (PostgreSQL)
# ===================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
POSTGRES_DB=tickets
POSTGRES_PORT=5432

# ===================================
# Redis Configuration
# ===================================
REDIS_PORT=6379

# ===================================
# Backend API Configuration
# ===================================
BACKEND_PORT=8000
DEBUG=false
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ===================================
# Security
# ===================================
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_RANDOM_32_BYTE_HEX

# ===================================
# Celery Worker Configuration
# ===================================
CELERY_WORKER_CONCURRENCY=8
CELERY_WORKER_PREFETCH_MULTIPLIER=2

# ===================================
# Frontend Configuration
# ===================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# ===================================
# AI Configuration (BYOK - Bring Your Own Key)
# ===================================
# Get your Gemini key from: https://makersuite.google.com/app/apikey
# NOTE: Users provide their own keys via the Settings page (stored in browser localStorage)
# Server-side key is optional fallback - leave empty to force BYOK
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI (not currently used)
# OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# ===================================
# Monitoring & Logging
# ===================================
LOG_LEVEL=INFO
SENTRY_DSN=  # Optional: Add Sentry for error tracking

# ===================================
# Rate Limiting
# ===================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
